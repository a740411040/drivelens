{
    "name": "drivelens-demo",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "postinstall": "node scripts/patch-vinext-static-cache.mjs",
        "dev": "vinext dev --port 3001",
        "build": "vinext build && node scripts/verify-production-assets.mjs",
        "build:native": "node scripts/build-native.mjs && node scripts/verify-production-assets.mjs",
        "start": "vinext start --port 3001 --hostname localhost",
        "test": "npm run build && node --test tests/rendered-html.test.mjs tests/diagnostic-toolbox.test.mjs tests/scoring-engine.test.mjs tests/collaboration-security.test.mjs",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release --ignore-pattern work",
        "assessment:generate": "node scripts/real-assessment.mjs",
        "assessment:check": "node scripts/real-assessment.mjs --check",
        "release:package": "npm run build && node scripts/create-release-package.mjs",
        "release:package:native": "npm run build:native && node scripts/create-release-package.mjs"
    },
    "dependencies": {
        "next": "16.2.6",
        "react": "19.2.6",
        "react-dom": "19.2.6"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.37.1",
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.26",
        "eslint": "9.39.4",
        "eslint-config-next": "16.2.6",
        "fflate": "0.7.4",
        "react-server-dom-webpack": "19.2.6",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vinext": "0.0.50",
        "vite": "8.0.13",
        "wrangler": "4.92.0"
    },
    "type": "module"
}

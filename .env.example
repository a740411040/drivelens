# Optional OpenAI-compatible model endpoint. Leave blank for deterministic evidence mode.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Public base URL used for Open Graph metadata after deployment.
# Keep localhost for the offline enterprise demo package.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Remote write endpoints are disabled on non-loopback hosts by default.
# For a hosted deployment, enable this only behind HTTPS and set a long random server-side token.
# Send the token as Authorization: Bearer or X-DriveLens-Token; never expose it as NEXT_PUBLIC_*.
DRIVELENS_REMOTE_WRITES_ENABLED=false
DRIVELENS_API_TOKEN=

# Feishu tenant app + Bitable sync. Secrets stay server-side only.
FEISHU_SYNC_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Optional target group for the interactive review card. Keep server-side.
FEISHU_CHAT_ID=

# Feishu AI evidence-task routing. Uses the same tenant app and Bitable app token.
# Keep false until the dedicated task table and its exact text fields are ready.
FEISHU_AI_TASK_SYNC_ENABLED=false
FEISHU_TASK_TABLE_ID=

# Reserved for the enterprise Aily and Wiki adapters documented in docs/FEISHU_AI_INTEGRATION.md.
# Access tokens are short-lived and must never be committed here.
FEISHU_AILY_APP_ID=
FEISHU_AILY_SKILL_ID=
FEISHU_WIKI_SPACE_ID=
